# Copy this file to .env and fill in your own keys.
# NEVER commit .env — it is already gitignored.

# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Sarvam AI API key (get from https://dashboard.sarvam.ai)
# Required for the default STT (Sarvam Saaras v3)
SARVAM_API_KEY=your-sarvam-api-key

# OpenAI API key (get from https://platform.openai.com/api-keys)
# Required for the default TTS (OpenAI nova voice)
OPENAI_API_KEY=your-openai-api-key

# Google AI Studio API key (get from https://aistudio.google.com/apikey)
# Required for the default LLM (Gemini 2.5 Flash)
GOOGLE_API_KEY=your-google-api-key

# Groq AI API key (optional — only if you switch LLM_PROVIDER to a Groq model)
GROQ_API_KEY=

# Deepgram API key (optional — only if you add Deepgram STT)
DEEPGRAM_API_KEY=

# Google Cloud credentials (only used when STT_PROVIDER = "google")
# Path to a service-account JSON file, or leave blank and run:
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase configuration for the ticketing system (create_ticket tool)
SUPABASE_URL=https://your-project-id.supabase.co/rest/v1
SUPABASE_API_KEY=your-supabase-api-key

# Optional pipeline overrides (defaults shown)
# STT_PROVIDER=sarvam      # sarvam | whisper
# LLM_PROVIDER=gemini      # gemini | openai
# TTS_PROVIDER=openai      # openai | sarvam

# Optional: full MCP server URL override (default http://127.0.0.1:8000/sse)
# Useful when running the MCP server behind a tunnel or on another machine.
# MCP_SERVER_URL=http://127.0.0.1:8000/sse
